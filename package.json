{
  "name": "janitorai-profile-css-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Live simulator for JanitorAI profile CSS, built on captures of the real profile page.",
  "scripts": {
    "start": "python tools/serve.py 5173",
    "studio:sync": "node tools/sync-to-next.mjs",
    "build:snapshot": "python tools/extract_snapshot.py",
    "build:fragments": "python tools/extract_fragments.py",
    "build:reference": "python tools/build_reference.py",
    "build:template": "python tools/build_template.py",
    "lint": "eslint .",
    "test": "node tests/smoke.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.0",
    "eslint": "9.39.0",
    "globals": "15.15.0",
    "playwright": "1.58.2"
  }
}
