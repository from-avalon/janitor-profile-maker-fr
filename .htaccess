# Served by Apache on the VPS; ignored by tools/serve.py locally and not copied
# by tools/sync-to-next.mjs. The studio is public — no auth here.

# Same caching policy as tools/serve.py (the regex is unanchored on purpose:
# the studio is served under a sub-path): captured data is cacheable, everything
# else is code you might have just pushed, so the browser must not hold on to it.
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#/preview/(profiles|assets)/#">
    Header set Cache-Control "public, max-age=3600"
  </If>
  <Else>
    Header set Cache-Control "no-store, must-revalidate"
  </Else>
</IfModule>

# The bundled profile is an .mhtml, which starts with MIME headers. mod_mime_magic
# reads those and adds "Content-Encoding: 7bit" to the response — an encoding no
# browser knows, so the fetch fails and the studio silently falls back to the
# built-in snapshot. Pin the type and strip the bogus header.
<FilesMatch "\.mhtml$">
  ForceType message/rfc822
  Header unset Content-Encoding
</FilesMatch>

# Compress text. Nothing on the box does this by default; the CSS/JS shrink 4-5x
# and the profile capture a good chunk, which matters on a slow link.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json image/svg+xml message/rfc822
</IfModule>
